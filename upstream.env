# The morethanwords/tweb commit Pluma is built from, of an MTProto schema
# layer the server speaks (README, Upstream). ci/patch.py checks that the
# checkout matches these values; an update changes them together.
UPSTREAM_REPO=https://github.com/morethanwords/tweb.git
UPSTREAM_REF=aa74832ed1976008d1ad1859d0b0cd671e75a7bd
# public/version of that commit: "2.3 (686)".
UPSTREAM_VERSION=2.3
UPSTREAM_BUILD=686
UPSTREAM_LAYER=233
# The toolchain: the pnpm of package.json "packageManager", and a Node.js
# its "engines" accept (the LTS line upstream's own Docker build uses).
NODE_VERSION=24.22.1
PNPM_VERSION=11.16.0
