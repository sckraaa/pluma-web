# A development server: the server repository's docker compose stack on the
# machine that runs the browser, whose gateway takes MTProto over WebSocket
# on port 11443. Builds for a real server take the URL and the key from the
# repository variables (README).
PLUMA_SERVER_URL=ws://localhost:11443/apiws
# The development server has no edge (a CDN or another host in front of the
# gateway that serves the site too); a build for a real server takes them
# from the repository variable PLUMA_EDGE_WS_URLS (README).
PLUMA_EDGE_WS_URLS=
