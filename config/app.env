# Identity of the Pluma web app (ci/patch.py): the page title and the name
# of the installed web app.
PLUMA_APP_NAME=Pluma
# api_id and api_hash identify the app to the server (not secrets: every
# client carries them). Pluma: 10001 Android, 10002 iOS, 10003 Desktop, 10004 Web.
PLUMA_API_ID=10004
PLUMA_API_HASH=036e9bcfb4175b817eae73952c7da3c5
# Releases every open tab must take (README, Updates of an open tab): a tab
# whose build has a lower number than the site it came from now leaves its
# page under a screen that reloads it. Raise it by one in the change that
# makes a release mandatory; never lower it.
PLUMA_REQUIRED_EPOCH=0
